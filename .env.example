# Copy to .env.local and fill in. Never commit real values.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# "From" address for outgoing email. Must be on a domain verified in Resend.
# For local testing without a verified domain, Resend allows onboarding@resend.dev
# (which can only deliver to the email address on your Resend account).
BOOKING_FROM_EMAIL="LØV Maastricht <bookings@example.com>"

# Inbox that receives new-booking notifications.
CAFE_NOTIFICATION_EMAIL=
